{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vBulletin Laravel Add-on Manifest",
  "description": "Schema definition for vb-addon.json manifest files in modern vBulletin add-ons.",
  "type": "object",
  "required": [
    "id",
    "version",
    "runtime",
    "provider"
  ],
  "anyOf": [
    { "required": ["title"] },
    { "required": ["name"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,24}$",
      "description": "Unique lowercase add-on identifier between 3 and 25 characters."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display title for the add-on."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Alternative alias for title."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$",
      "description": "Semantic version of the add-on."
    },
    "runtime": {
      "type": "string",
      "pattern": "^\\^(\\d+)\\.(\\d+)(?:\\.(\\d+))?$",
      "description": "Semver constraint targeting the vb-laravel runtime (e.g. ^0.2, ^0.10, ^1.0)."
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\\\]+$",
      "description": "Fully-qualified class name of the add-on Service Provider."
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "autoload": {
      "type": "object",
      "properties": {
        "psr-4": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
