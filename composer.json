{
    "name": "vb-laravel/runtime",
    "description": "A lightweight Illuminate runtime and vBulletin bridge.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "illuminate/container": "^11.0",
        "illuminate/database": "^11.0",
        "brick/math": "0.14.1",
        "symfony/deprecation-contracts": "3.6.0",
        "voku/portable-ascii": "2.0.3"
    },
    "autoload": {
        "psr-4": {
            "VbLaravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require-dev": {
        "nikic/php-parser": "^5.0"
    },
    "bin": [
        "bin/vbl"
    ],
    "config": {
        "sort-packages": true
    }
}
