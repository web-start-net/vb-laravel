<?xml version="1.0" encoding="utf-8"?>
<product productid="vbbookmarks" active="1">
    <title>VB Bookmarks</title>
    <description>Private vBulletin bookmarks powered by VB Laravel.</description>
    <version>1.0.0</version>
    <url></url>
    <versioncheckurl></versioncheckurl>
    <dependencies></dependencies>
    <codes>
        <code version="1.0.0">
            <installcode><![CDATA[
                $assertor = vB::getDbAssertor();
                $assertor->assertQuery('vbbookmarks:create_bookmark');
            ]]></installcode>
            <uninstallcode><![CDATA[
                $assertor = vB::getDbAssertor();
                $assertor->assertQuery('vbbookmarks:drop_bookmark');
            ]]></uninstallcode>
        </code>
    </codes>
    <templates>
        <template name="vbbookmarks_page" templatetype="template" date="1760000000" username="VB Laravel" version="1.0.0"><![CDATA[
{vb:data content, vbbookmarks:bookmarks, fetch}
<section class="vbbookmarks">
    <h1>{vb:phrase vbbookmarks_title}</h1>
    <vb:if condition="!$content['authorized']">
        <p>{vb:phrase vbbookmarks_login_required}</p>
    <vb:else />
        <form method="post" action="{vb:var content.urls.add}">
            <input type="hidden" name="bookmark_action" value="store" />
            <input type="hidden" name="securitytoken" value="{vb:raw content.securitytoken}" />
            <label for="vbbookmarks-nodeid">{vb:phrase vbbookmarks_nodeid}</label>
            <input id="vbbookmarks-nodeid" type="number" name="nodeid" min="1" required="required" />
            <button type="submit">{vb:phrase vbbookmarks_add}</button>
        </form>
        <vb:if condition="empty($content['bookmarks'])">
            <p>{vb:phrase vbbookmarks_empty}</p>
        <vb:else />
            <ul>
                <vb:each from="content.bookmarks" value="bookmark">
                    <li>
                        <a href="{vb:var bookmark.url}">{vb:var bookmark.title}</a>
                        <span>{vb:var bookmark.created_at}</span>
                        <form method="post" action="{vb:var content.urls.remove}" style="display:inline">
                            <input type="hidden" name="bookmark_action" value="destroy" />
                            <input type="hidden" name="nodeid" value="{vb:raw bookmark.nodeid}" />
                            <input type="hidden" name="securitytoken" value="{vb:raw content.securitytoken}" />
                            <button type="submit">{vb:phrase vbbookmarks_remove}</button>
                        </form>
                    </li>
                </vb:each>
            </ul>
        </vb:if>
    </vb:if>
</section>
]]></template>
    </templates>
