        <page guid="vbbookmarks-page-1"><title>VB Bookmarks</title><metadescription>Private vBulletin bookmarks.</metadescription><moderatorid>0</moderatorid><displayorder>1</displayorder><pagetype>default</pagetype><parentGuid></parentGuid><pageTemplateGuid>vbbookmarks-pagetemplate-1</pageTemplateGuid><routeGuid>vbbookmarks-route-1</routeGuid></page>
