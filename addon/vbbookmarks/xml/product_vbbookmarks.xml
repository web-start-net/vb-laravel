        <route guid="vbbookmarks-route-1"><name>vbbookmarks</name><prefix>bookmarks</prefix><regex><![CDATA[bookmarks]]></regex><class>vB5_Route_Page</class><controller>page</controller><action>index</action><arguments><![CDATA[a:1:{s:8:"pageGuid";s:18:"vbbookmarks-page-1";}]]></arguments><product>vbbookmarks</product></route>
        <route guid="vbbookmarks-route-add-1"><name>vbbookmarks_add</name><prefix>bookmarks/add</prefix><regex><![CDATA[bookmarks/add]]></regex><class>vB5_Route_Page</class><controller>page</controller><action>index</action><arguments><![CDATA[a:1:{s:8:"pageGuid";s:18:"vbbookmarks-page-1";}]]></arguments><product>vbbookmarks</product></route>
