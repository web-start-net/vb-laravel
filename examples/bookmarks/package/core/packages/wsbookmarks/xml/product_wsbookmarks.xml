<?xml version="1.0" encoding="utf-8"?>
<product productid="wsbookmarks" active="1">
    <title>Bookmarks</title>
    <description>Lightweight bookmarks addon powered by vb-laravel</description>
    <version>1.0.0</version>
    <url></url>
    <versioncheckurl></versioncheckurl>
    <dependencies>
        <dependency dependencytype="product" parentproductid="vblaravel" minversion="0.2.0" />
    </dependencies>
    <codes>
        <code version="1.0.0">
            <installcode><![CDATA[$vblBootstrap = DIR . '/packages/vblaravel/bootstrap.php';
if (is_file($vblBootstrap)) {
    require_once $vblBootstrap;
}
if (class_exists('\VbLaravel\Migrator')) {
    \VbLaravel\Migrator::up(DIR . '/packages/wsbookmarks');
}
]]></installcode>
            <uninstallcode><![CDATA[$vblBootstrap = DIR . '/packages/vblaravel/bootstrap.php';
if (is_file($vblBootstrap)) {
    require_once $vblBootstrap;
}
if (class_exists('\VbLaravel\Migrator')) {
    \VbLaravel\Migrator::down(DIR . '/packages/wsbookmarks');
}
]]></uninstallcode>
        </code>
    </codes>
    <templates>
        <template name="wsbookmarks_bookmark_button" templatetype="template"><![CDATA[<div class="ws-bookmark-container" data-nodeid="{vb:raw node.nodeid}">
    <button type="button" class="btn btn-secondary ws-bookmark-btn">Bookmark</button>
</div>
]]></template>
        <template name="wsbookmarks_hook_header_head" templatetype="template"><![CDATA[<style>
.ws-bookmark-container {
    display: inline-block;
    margin: 4px 0;
}
.ws-bookmark-btn {
    cursor: pointer;
}
</style>
]]></template>
    </templates>
    <plugins></plugins>
    <phrases>
        <phrasetype name="vbulletin_settings" fieldname="vbsettings">
            <phrase name="setting_wsbookmarks_enabled_title"><![CDATA[Enable Bookmarks]]></phrase>
            <phrase name="setting_wsbookmarks_enabled_desc"><![CDATA[Allow registered users to bookmark threads and posts.]]></phrase>
        </phrasetype>
    </phrases>
    <hooks>
        <hook active="1" hookname="header_head" template="wsbookmarks_hook_header_head" arguments="" />
    </hooks>
    <settinggroups>
        <settinggroup name="wsbookmarks" displayorder="100">
            <title>Bookmarks Settings</title>
        </settinggroup>
    </settinggroups>
    <settings>
        <setting varname="wsbookmarks_enabled" displayorder="10">
            <settinggroup>wsbookmarks</settinggroup>
            <type>boolean</type>
            <value>1</value>
            <defaultvalue>1</defaultvalue>
        </setting>
    </settings>
</product>
