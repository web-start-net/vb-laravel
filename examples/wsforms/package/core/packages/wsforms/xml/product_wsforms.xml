<?xml version="1.0" encoding="utf-8"?>
<product productid="wsforms" active="1">
    <title>Custom Form Builder</title>
    <description>Heavyweight relational form builder demonstration for vBulletin 6 using vb-laravel</description>
    <version>1.0.1</version>
    <url></url>
    <versioncheckurl></versioncheckurl>
    <dependencies>
        <dependency dependencytype="product" parentproductid="vblaravel" minversion="0.2.0" maxversion="" />
    </dependencies>
    <codes>
        <code version="*">
            <installcode><![CDATA[$vblBootstrap = DIR . '/packages/vblaravel/bootstrap.php';
if (is_file($vblBootstrap)) {
    require_once $vblBootstrap;
}
if (class_exists('\VbLaravel\Migrator')) {
    \VbLaravel\Migrator::up(DIR . '/packages/wsforms');
}
]]></installcode>
            <uninstallcode><![CDATA[$vblBootstrap = DIR . '/packages/vblaravel/bootstrap.php';
if (is_file($vblBootstrap)) {
    require_once $vblBootstrap;
}
if (class_exists('\VbLaravel\Migrator')) {
    \VbLaravel\Migrator::down(DIR . '/packages/wsforms');
}
]]></uninstallcode>
        </code>
    </codes>
    <templates>
        <template name="wsforms_form_view" templatetype="template" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[<div class="ws-form-wrapper" id="ws-form-{vb:raw form.id}">
    <h2>{vb:raw form.title}</h2>
    <p>{vb:raw form.description}</p>
    <form method="post" action="{vb:raw form.action_url}">
        <input type="hidden" name="securitytoken" value="{vb:raw userinfo.securitytoken}" />
        <input type="hidden" name="form_id" value="{vb:raw form.id}" />
        {vb:raw form.fields_rendered}
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
]]></template>
        <template name="wsforms_hook_header_head" templatetype="template" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[<style>
.ws-form-wrapper {
    background: #fff;
    padding: 16px;
    border-radius: 4px;
    margin-bottom: 16px;
}
</style>
]]></template>
    </templates>
    <plugins></plugins>
    <phrases>
        <phrasetype name="vbulletin_settings" fieldname="vbsettings">
            <phrase name="setting_wsforms_enabled_title" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[Enable Custom Forms]]></phrase>
            <phrase name="setting_wsforms_enabled_desc" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[Globally enable or disable custom form submissions.]]></phrase>
            <phrase name="setting_wsforms_max_submissions_title" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[Max Submissions Per User]]></phrase>
            <phrase name="setting_wsforms_max_submissions_desc" date="1786800000" username="VB Laravel" version="1.0.1"><![CDATA[Maximum allowed form entries per user account.]]></phrase>
        </phrasetype>
    </phrases>
    <hooks>
        <hook>
            <hookname>header_head</hookname>
            <title>Custom Form Builder</title>
            <active>1</active>
            <hookorder>10</hookorder>
            <template>wsforms_hook_header_head</template>
            <arguments />
        </hook>
    </hooks>
    <settinggroups>
        <settinggroup name="wsforms" displayorder="100">
            <title>Form Builder Settings</title>
        </settinggroup>
    </settinggroups>
    <settings>
        <setting varname="wsforms_enabled" displayorder="10">
            <settinggroup>wsforms</settinggroup>
            <type>boolean</type>
            <value>1</value>
            <defaultvalue>1</defaultvalue>
        </setting>
        <setting varname="wsforms_max_submissions" displayorder="20">
            <settinggroup>wsforms</settinggroup>
            <type>integer</type>
            <value>50</value>
            <defaultvalue>50</defaultvalue>
        </setting>
    </settings>
</product>
